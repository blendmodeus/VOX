{
    "name": "vox",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "VØX Mac App — Your Voice is the Interface",
    "main": "electron-main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "electron:dev": "electron . --no-sandbox",
        "electron:build": "electron-builder"
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "vite": "^6.0.0"
    },
    "build": {
        "appId": "com.axiom.vox",
        "productName": "VØX",
        "mac": {
            "category": "public.app-category.productivity",
            "target": "dmg",
            "icon": "assets/icon.icns"
        },
        "files": [
            "electron-main.cjs",
            "preload.cjs",
            "dist/**/*",
            "visualizer.html",
            "settings.html"
        ]
    }
}